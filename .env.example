# ── Server ────────────────────────────────────────────────────────────────────

# Port the Next.js server listens on
PORT=3000

# Agent provider: "openclaw" (default) or "auggie"
AGENT_PROVIDER=openclaw

# Internal WebSocket URL of the OpenClaw gateway (server-side only).
# The server proxies browser connections from /api/gateway to this address.
GATEWAY_URL=ws://127.0.0.1:18789/

# Additional domains to allow in the Content-Security-Policy connect-src directive.
# Useful when connecting to remote gateways or external services.
# Example: "wss://mygateway.example.com https://api.example.com"
# CSP_CONNECT_SRC=

# ── Client (browser-visible, prefix NEXT_PUBLIC_) ─────────────────────────────

# Gateway bearer token sent in the WebSocket handshake.
# Must match the token configured in ~/.openclaw/openclaw.json > gateway.auth.token
NEXT_PUBLIC_GATEWAY_TOKEN=your_gateway_token_here

# Optional: override the WebSocket URL used by the browser.
# Defaults to ws(s)://{window.location.host}/api/gateway (the built-in proxy).
# Only set this if you want the browser to connect to a different gateway directly.
# NEXT_PUBLIC_GATEWAY_URL=
